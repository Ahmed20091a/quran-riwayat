{"src":"تحفة الأطفال والغلمان — سليمان الجمزوري","rules":{"الإظهار الحلقي":[{"n":7,"a":"فَالأَوَّلُ الإظْهَارُ قَبْلَ أَحْرُفِ","b":"لِلْحَلْقِ سِتٌّ رُتِّبَتْ فَلْتَعْرِفِ"},{"n":8,"a":"هَمْزٌ فَهَاءٌ ثُمَّ عَيْنٌ حَاءُ","b":"مُهْمَلَتَانِ ثُمَّ غَيْنٌ خَاءُ"}],"الإدغام بغنة":[{"n":9,"a":"والثَّاني إِدْغَامٌ بِستَّةٍ أَتَتْ","b":"فِي «يَرْمَلُونَ» عِنْدَهُمْ قَدْ ثَبَتَتْ"},{"n":10,"a":"لَكِنَّهَا قِسْمَانِ قِسْمٌ يُدْغَمَا","b":"فِيهِ بِغُنَّةٍ بِـ«يَنْمُو» عُلِمَا"},{"n":11,"a":"إِلاَّ إِذَا كَانَا بِكِلْمَةٍ فَلاَ","b":"تُدْغِمْ كَـ«دُنْيَا» ثُمَّ «صِنْوَانٍ» تَلاَ"}],"الإدغام بغير غنة":[{"n":9,"a":"والثَّاني إِدْغَامٌ بِستَّةٍ أَتَتْ","b":"فِي «يَرْمَلُونَ» عِنْدَهُمْ قَدْ ثَبَتَتْ"},{"n":12,"a":"وَالثَّاني إِدْغَامٌ بِغَيْرِ غُنَّةْ","b":"في اللاَّمِ وَالرَّا ثُمَّ كَرّرَنَّهْ"}],"الإقلاب":[{"n":13,"a":"وَّالثَالثُ الإِقْلاَبُ عِنْدَ الْبَاءِ","b":"مِيماً بِغُنَةٍ مَعَ الإِخْفَاءِ"}],"الإخفاء الحقيقي":[{"n":14,"a":"وَالرَّابِعُ الإِخْفَاءُ عِنْدَ الْفاضِلِ","b":"مِنَ الحُرُوفِ وَاجِبٌ لِلْفَاضِلِ"},{"n":15,"a":"في خَمْسَةٍ مِنْ بَعْدِ عَشْرٍ رَمْزُهَا","b":"فِي كِلْمِ هذَا البَيْتِ قَدْ ضَمَّنْتُهَا"},{"n":16,"a":"«صِفْ ذَا ثَنَا، كَمْ جَادَ شَخْصٌ قَدْ سمَا","b":"دُمْ طَيَّباً، زِدْ فِي تُقَىً، ضَعْ ظَالِمَا»"}],"الغنة في المشددتين":[{"n":17,"a":"وَغُنَّ مِيمًا ثُمَّ نُونًا شُدِّدَا","b":"وَسَمِّ كُلاً حَرْفَ غُنَّةٍ بَدَا"}],"الإخفاء الشفوي":[{"n":20,"a":"فَالأَوَّلُ الإِخْفَاءُ عِنْدَ الْبَاءِ","b":"وَسَمِّهِ الشَّفْوِيَّ لِلْقُرَّاءِ"}],"الإظهار الشفوي":[{"n":22,"a":"وَالثَّالِثُ الإِظْهَارُ فِي الْبَقِيَّهْ","b":"مِنْ أَحْرُفٍ وَسَمِّهَا شَفْوِيَّهْ"},{"n":23,"a":"وَاحْذَرْ لَدَى وَاوٍ وَفَا أَنْ تَخْتَفِي","b":"لِقُرْبِهَا وَلاتِّحَادِ فَاعْرِفِ"}],"اللام القمرية":[{"n":24,"a":"لِلاَمِ أَلْ حَالاَنِ قَبْلَ الأَحْرُفِ","b":"أُولاَهُمَا إِظْهَارُهَا فَلْتَعْرِفِ"},{"n":25,"a":"قَبْلَ ارْبَعٍ مَعْ عَشْرَةٍ خُذْ عِلْمَهُ","b":"مِنِ (ابْغِ حَجَّكَ وَخَفْ عَقِيمَهُ)"},{"n":28,"a":"وَاللاَّمُ الاُولَى سَمِّهَا قَمَرِيَّهْ","b":"وَاللاَّمَ الاُخْرَى سَمِّهَا شَمْسِيَّهْ"}],"اللام الشمسية":[{"n":26,"a":"ثَانِيهِمَا إِدْغَامُهَا فِي أَرْبَعِ","b":"وَعَشْرَةٍ أَيْضًا وَرَمْزَهَا فَعِ"},{"n":27,"a":"طِبْ ثُمَّ صِلْ رُحْمًا تَفُزْ ضِفْ ذَا نِعَمْ","b":"دَعْ سُوءَ ظَنٍّ زُرْ شَرِيفًا لِلْكَرَمْ"},{"n":28,"a":"وَاللاَّمُ الاُولَى سَمِّهَا قَمَرِيَّهْ","b":"وَاللاَّمَ الاُخْرَى سَمِّهَا شَمْسِيَّهْ"}],"المتماثلان":[{"n":30,"a":"إِنْ فِي الصِّفَاتِ وَالمَخَارِجِ اتَّفَقْ","b":"حَرْفَانِ فَالْمِثْلاَنِ فِيهِمَا أَحَقْ"},{"n":33,"a":"بِالْمُتَجَانِسَيْنِ ثُمَّ إِنْ سَكَنْ","b":"أَوَّلُ كُلٍّ فَالصَّغِيرَ سَمِّيَنْ"},{"n":34,"a":"أَوْ حُرِّكَ الحَرْفَانِ فِي كُلٍّ فَقُلْ","b":"كُلٌّ كَبِيرٌ وافْهَمَنْهُ بِالْمُثُلْ"}],"المتقاربان":[{"n":30,"a":"إِنْ فِي الصِّفَاتِ وَالمَخَارِجِ اتَّفَقْ","b":"حَرْفَانِ فَالْمِثْلاَنِ فِيهِمَا أَحَقْ"},{"n":31,"a":"وَإِنْ يَكُونَا مَخْرَجًا تَقَارَبَا","b":"وَفِي الصِّفَاتِ اخْتَلَفَا يُلَقَّبَا"},{"n":32,"a":"مُتَقَارِبَيْنِ أَوْ يَكُونَا اتَّفَقَا","b":"فِي مَخْرَجٍ دُونَ الصِّفَاتِ حُقِّقَا"}],"المتجانسان":[{"n":30,"a":"إِنْ فِي الصِّفَاتِ وَالمَخَارِجِ اتَّفَقْ","b":"حَرْفَانِ فَالْمِثْلاَنِ فِيهِمَا أَحَقْ"},{"n":31,"a":"وَإِنْ يَكُونَا مَخْرَجًا تَقَارَبَا","b":"وَفِي الصِّفَاتِ اخْتَلَفَا يُلَقَّبَا"},{"n":32,"a":"مُتَقَارِبَيْنِ أَوْ يَكُونَا اتَّفَقَا","b":"فِي مَخْرَجٍ دُونَ الصِّفَاتِ حُقِّقَا"},{"n":33,"a":"بِالْمُتَجَانِسَيْنِ ثُمَّ إِنْ سَكَنْ","b":"أَوَّلُ كُلٍّ فَالصَّغِيرَ سَمِّيَنْ"},{"n":34,"a":"أَوْ حُرِّكَ الحَرْفَانِ فِي كُلٍّ فَقُلْ","b":"كُلٌّ كَبِيرٌ وافْهَمَنْهُ بِالْمُثُلْ"}],"المد الطبيعي":[{"n":35,"a":"أقْسَامُ المَدِّوَالْمَدُّ أَصْلِيٌّ وَفَرْعِيٌّ لَهُ","b":"وَسَمِّ أَوَّلاً طَبِيعِيًّا وَهُو"},{"n":36,"a":"مَا لاَ تَوَقُّفٌ لَهُ عَلَى سَبَبْ","b":"وَلا بِدُونِهِ الحُرُوفُ تُجْتَلَبْ"},{"n":37,"a":"بلْ أَيُّ حَرْفٍ غَيْرُ هَمْزٍ أَوْ سُكُونْ","b":"جَا بَعْدَ مَدٍّ فَالطَّبِيعِيَّ يَكُونْ"},{"n":55,"a":"وَمَا سِوَى الحَرْفِ الثُّلاَثِي لاَ أَلِفْ","b":"فَمَدُّهُ مَدًّا طَبِيعِيًّا أُلِفْ"},{"n":56,"a":"وَذَاكَ أَيْضًا فِي فَوَاتِحِ السُّوَرْ","b":"فِي لَفْظِ (حَيٍّ طَاهِرٍ) قَدِ انْحَصَرْ"}],"مد اللين":[{"n":41,"a":"وَاللِّينُ مِنْهَا الْيَا وَوَاوٌ سُكِّنَا","b":"إِنِ انْفِتَاحٌ قَبْلَ كُلٍّ أُعْلِنَا"}],"المد المتصل":[{"n":43,"a":"فَوَاجِبٌ إِنْ جَاءَ هَمْزٌ بَعْدَ مَدْ","b":"فِي كِلْمَةٍ وَذَا بِمُتَّصِلٍ يُعَدْ"}],"المد المنفصل":[{"n":44,"a":"وَجَائِزٌ مَدٌّ وَقَصْرٌ إِنْ فُصِلْ","b":"كُلٌّ بِكِلْمَةٍ وَهَذَا المُنْفَصِلْ"}],"المد العارض للسكون":[{"n":45,"a":"وَمِثْلُ ذَا إِنْ عَرَضَ السُّكُونُ","b":"وَقْفًا كَتَعْلَمُونَ نَسْتَعِينُ"}],"المد البدل":[{"n":46,"a":"أَوْ قُدِّمَ الْهَمْزُ عَلَى المَدِّ وَذَا","b":"بَدَلْ كَآمَنُوا وَإِيمَانًا خُذَا"}],"المد اللازم":[{"n":47,"a":"وَلاَزِمٌ إِنِ السُّكُونُ أُصِّلاَ","b":"وَصْلاً وَوَقْفًا بَعْدَ مَدٍّ طُوِّلاَ"},{"n":48,"a":"أقْسَامُ المَدِّ الَّلازِمِأَقْسَامُ لاَزِمٍ لَدَيْهِمْ أَرْبَعَهْ","b":"وَتِلْكَ كِلْمِيٌّ وَحَرْفِيٌّ مَعَهْ"},{"n":49,"a":"كِلاَهُمَا مُخَفَّفٌ مُثَقَّلُ","b":"فَهَذِهِ أَرْبَعَةٌ تُفَصَّلُ"},{"n":50,"a":"فَإِنْ بِكِلْمَةٍ سُكُونٌ اجْتَمَعْ","b":"مَعْ حَرْفِ مَدٍّ فَهْوَ كِلْمِيٌّ وَقَعْ"},{"n":51,"a":"أَوْ فِي ثُلاَثِيِّ الحُرُوفِ وُجِدَا","b":"وَالمَدُّ وَسْطُهُ فَحَرْفِيٌّ بَدَا"},{"n":52,"a":"كِلاَهُمَا مُثَقَّلٌ إِنْ أُدْغِمَا","b":"مَخَفَّفٌ كُلٌّ إِذَا لَمْ يُدْغَمَا"},{"n":53,"a":"وَاللاَّزِمُ الْحَرْفِيُّ أَوَّلَ السُّوَرْ","b":"وُجُودُهُ وَفِي ثَمَانٍ انْحَصَرْ"},{"n":54,"a":"يَجْمَعُهَا حُرُوفُ (كَمْ عَسَلْ نَقَصْ)","b":"وَعَيْنُ ذُو وَجْهَيْنِ والطُّولُ أَخَصْ"}]}}